# MongoDB connection string (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, defaults to StudioSpace)
MONGODB_DB_NAME=StudioSpace

# Long random string used to sign session cookies
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Local development URL. On Vercel this is detected automatically.
BETTER_AUTH_URL=http://localhost:5000

# Comma-separated list of browser origins allowed to call this API.
# Local development defaults to http://localhost:3000 automatically.
# On Vercel set it to your deployed client URL, e.g. https://your-client.vercel.app
# Wildcards are supported for preview deployments, e.g. https://your-client-*.vercel.app
CLIENT_URLS=http://localhost:3000

# Local only (Vercel assigns the port automatically)
PORT=5000
